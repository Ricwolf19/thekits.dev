{
  "name": "thekits.dev",
  "version": "0.1.0",
  "private": true,
  "description": "Docs, playgrounds and releases for listkit and uploaderkit",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "ci": "bun run format && bun run lint && bun run typecheck && bun run test && bun run build",
    "verify": "bun run ci",
    "content:check": "bun run scripts/verify-live.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fumadocs-core": "16.15.12",
    "fumadocs-ui": "16.15.12",
    "geist": "^1.7.2",
    "github-slugger": "^2.0.0",
    "listkit": "^5.0.0",
    "lucide-react": "^0.471.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-slug": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "uploaderkit": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/github-slugger": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^30.1.0",
    "prettier": "^3",
    "secretlint": "^13.0.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4"
  }
}
